# Copy this file to flowplanv2.local.env and fill in your real values.
# The launcher automatically loads:
#   C:\Users\a2746\Desktop\calll260426\flowplanv2.local.env
#   C:\Users\a2746\Desktop\calll260426\server\flowplanv2.local.env
#   C:\Users\a2746\Desktop\calll260426\server\.env

FLOWPLANV2_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Local PostgreSQL example:
# FLOWPLANV2_DATABASE_URL=postgres://postgres:postgres@localhost:5432/flowplanv2

# Optional. The script also accepts -ServerPort, so this is usually not needed.
# PORT=3202
