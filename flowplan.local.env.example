# Copy this file to flowplan.local.env and fill in your real values.
# The launcher automatically loads:
#   C:\Users\a2746\Desktop\calll260426\flowplan.local.env
#   C:\Users\a2746\Desktop\calll260426\server\flowplan.local.env
#   C:\Users\a2746\Desktop\calll260426\server\.env

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Local PostgreSQL example:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/flowplan

# Optional. The script also accepts -ServerPort, so this is usually not needed.
# PORT=3200
