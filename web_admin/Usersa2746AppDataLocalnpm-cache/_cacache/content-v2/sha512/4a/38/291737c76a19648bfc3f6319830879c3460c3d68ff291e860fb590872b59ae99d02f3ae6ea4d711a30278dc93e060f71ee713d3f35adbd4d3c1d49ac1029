ic file serving, use the exported `getAbsoluteFSPath` method:\n\n```javascript\nconst swaggerUiAssetPath = require(\"swagger-ui-dist\").getAbsoluteFSPath()\n\n// then instantiate server that serves files from the swaggerUiAssetPath\n```\n\nFor anything else, check the [Swagger-UI](https://github.com/swagger-api/swagger-ui) repository.\n","time":{"created":"2022-01-26T15:50:28.798Z","modified":"2026-04-27T12:56:50.677Z","4.5.0":"2022-02-04T18:05:12.130Z","4.4.1":"2022-01-31T14:04:30.289Z","4.4.0":"2022-01-27T09:39:20.052Z","4.1.3":"2021-12-10T13:04:00.285Z","4.1.2":"2021-11-26T10:36:08.181Z","4.1.1":"2021-11-25T15:36:28.595Z","4.1.0":"2021-11-08T13:03:43.643Z","4.0.1":"2021-11-04T16:07:37.913Z","4.0.0":"2021-11-03T10:03:59.356Z","3.52.5":"2021-10-14T14:26:40.773Z","4.0.0-rc.4":"2021-10-14T13:33:08.311Z","3.52.4":"2021-10-11T11:49:21.362Z","4.0.0-rc.3":"2021-10-11T10:40:23.998Z","3.52.3":"2021-09-20T12:14:10.699Z","4.0.0-rc.2":"2021-09-20T11:43:25.745Z","3.52.2":"2021-09-13T12:47:42.011Z","4.0.0-rc.1":"2021-09-13T11:33:51.999Z","3.52.1":"2021-09-10T12:06:16.255Z","4.0.0-rc.0":"2021-09-10T11:30:11.336Z","4.0.0-beta.4":"2021-08-12T13:28:09.473Z","4.0.0-beta.3":"2021-08-11T14:20:26.576Z","3.52.0":"2021-08-09T15:15:53.355Z","4.0.0-beta.2":"2021-07-30T13:20:20.714Z","3.51.2":"2021-07-30T10:12:33.921Z","4.0.0-beta.1":"2021-07-23T08:07:29.529Z","4.0.0-beta.0":"2021-07-14T15:57:28.316Z","3.51.1":"2021-06-30T20:44:34.489Z","3.51.0":"2021-06-23T18:36:43.282Z","3.50.0":"2021-06-03T21:02:20.946Z","3.49.0":"2021-05-19T21:56:55.295Z","3.48.0":"2021-04-29T22:12:59.160Z","3.47.1":"2021-04-15T21:58:36.129Z","3.46.0":"2021-03-31T18:52:53.413Z","3.45.1":"2021-03-19T17:16:35.022Z","3.45.0":"2021-03-11T17:22:30.616Z","3.44.1":"2021-03-04T18:15:30.185Z","3.44.0":"2021-02-25T00:31:01.128Z","3.43.0":"2021-02-11T18:55:27.285Z","3.42.0":"2021-02-04T18:23:28.879Z","3.41.1":"2021-01-28T19:58:45.984Z","3.41.0":"2021-01-28T18:11:17.286Z","3.40.0":"2021-01-14T20:22:28.377Z","3.39.0":"2021-01-07T21: