otlib() });\n\nconst chart = new Chart({ container: \"container\" });\n\n  chart\n    .sunburst()\n    .data({\n      type: 'fetch',\n      value: 'https://gw.alipayobjects.com/os/antfincdn/ryp44nvUYZ/coffee.json',\n    })\n    .animate('enter', { type: 'waveIn' })\n    .coordinate({ type: 'polar', innerRadius: 0 });\n\n  chart.render();\n```\n\n## License\n\nMIT@[AntV](https://github.com/antvis).\n","repository":{"type":"git","url":"git+https://github.com/antvis/g2-extensions.git"},"_source_registry_name":"default"}